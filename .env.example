# Copy this file to .env (already in .gitignore) and fill in real values.
# Loaded automatically by every `harness` command (harness/cli.py's
# _load_env_file) -- an explicit `export` in your shell always wins over
# whatever's in here.

# Only needed to use an explicit `--model openrouter/...` / `/model
# openrouter/...` override -- OpenRouter is never auto-selected by
# routing (HANDOFF.md §2.27). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
